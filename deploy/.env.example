# Copy to .env and fill in. .env is gitignored.

# DNS name already pointing at this host. Caddy completes an ACME challenge
# against it on first start, so the A record must resolve before you bring the
# stack up. The server's public address is https://$DEXIO_DOMAIN unless you set
# DEXIO_PUBLIC_URL.
DEXIO_DOMAIN=wiki.example.com

# Optional: seed the first account instead of signing up in the browser.
DEXIO_ADMIN_EMAIL=
DEXIO_ADMIN_PASSWORD=

# Files agents upload. Empty keeps them in a folder under the data directory.
# Set DEXIO_FILES_BUCKET (and give the host AWS credentials) to use S3 instead.
DEXIO_FILES_SSM=
DEXIO_FILES_BUCKET=

# Optional: Postgres instead of the SQLite file under the data directory.
# DEXIO_DATABASE_URL=postgresql://user:password@host:5432/dexio

# Optional: email through Amazon SES (sign-in links, invitations). Without it,
# sign-in is by password and emails are logged instead of sent.
# DEXIO_MAIL=ses
# DEXIO_MAIL_FROM=Dexio <no-reply@wiki.example.com>
# DEXIO_MAIL_REPLY_TO=you@example.com
# DEXIO_CONTACT_TO=you@example.com

# Optional: sign in with Google or GitHub. Each button appears once its id and
# secret are set. Callback URLs: https://$DEXIO_DOMAIN/auth/google/callback and
# https://$DEXIO_DOMAIN/auth/github/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Where the database, files and certificates live on the host.
# DEXIO_DATA_DIR=./data
